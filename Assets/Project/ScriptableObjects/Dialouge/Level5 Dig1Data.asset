  lines:
  - text: '"Enough with the traps."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"I''m done playing with you."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"If you won''t give up..."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"Then I''ll take matters into my own hands."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"Come on, DEV..."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"Give me your best."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
