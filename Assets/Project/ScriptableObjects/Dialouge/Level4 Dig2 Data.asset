  m_Script: {fileID: 11500000, guid: ecd7cfece835a8848b5b8778383aca6b, type: 3}
  m_Name: Level4 Dig2 Data
  m_EditorClassIdentifier: Assembly-CSharp::DarkPixelGD.Narrator.DialogueDataSO
  speakerName: Unknown Entity
  lines:
  - text: '"So... you restored your controls."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"You must be feeling pretty confident now."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"But there''s something you seem to have forgotten..."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"I''m still in control."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"Now you know how it feels..."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"When the rules change..."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"And the protagonist has no choice but to face them."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"Welcome to my world, DEV."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
