  m_Script: {fileID: 11500000, guid: ecd7cfece835a8848b5b8778383aca6b, type: 3}
  m_Name: Level3 Dig1 Data
  m_EditorClassIdentifier: Assembly-CSharp::DarkPixelGD.Narrator.DialogueDataSO
  speakerName: Developer
  lines:
  - text: '"What just happened?"'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"Did your precious controls stop listening to you?"'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"You made me suffer through this..."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"So now it''s your turn."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"You made it this far..."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"But this is nowhere near the end."'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
  - text: '"Suffer... suffer... SUFFER!"'
    voiceClip: {fileID: 0}
    minDisplayDuration: 1.5
